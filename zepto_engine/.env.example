# Copy this file to .env and fill in real values. Never put secrets in THIS file
# — .env.example is the committable template; .env is the gitignored real one.
ZEPTO_EMAIL=you@example.com
ZEPTO_PASSWORD=your-portal-password

# Mailbox that receives the login OTP. This domain is on Google Workspace, so
# IMAP_PASSWORD must be a Google APP PASSWORD (16 chars), not the login password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
IMAP_HOST=imap.gmail.com
IMAP_USER=orders@example.com
IMAP_PASSWORD=

# Who gets an email when the daily run fails — comma-separated, defaults to
# IMAP_USER. Sent from that same mailbox over SMTP with the same app password.
NOTIFY_TO=orders@example.com

# The spreadsheet to write into — the long id from its URL. Kept out of the code
# so a public repo does not expose it: the workbook is readable by anyone with
# the link, so the id is effectively a credential.
GSHEET_ID=your-spreadsheet-id

# Set to 1 to watch the browser while it works, 0 to run invisibly (for the daily job)
HEADED=1
