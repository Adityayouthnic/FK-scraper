PORT=8080

# Shared secret required to click Run from the browser (pick any long random string)
ACCESS_TOKEN=

# Flipkart seller login — used only when there's no valid saved session
# (see SESSION_BUCKET below), never commit real values
FLIPKART_EMAIL=
FLIPKART_PASSWORD=

# Google Sheets (service account)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1
# Path to a service-account JSON file (local dev) OR the JSON content itself (Cloud Run secret)
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Optional: persist the logged-in session to a Cloud Storage bucket so most
# runs can skip login+captcha entirely. Leave blank to always log in fresh
# via the interactive live-view flow (no extra GCP setup needed).
SESSION_BUCKET=
SESSION_OBJECT=flipkart-session.json

# How many recent calendar days (ending yesterday) to scan for gaps and
# backfill on each run.
LOOKBACK_DAYS=7
